{
  "name": "doppar/ia",
  "description": "Doppar/AI",
  "keywords": ["doppar", "transformer", "llm", "language", "model"],
  "homepage": "https://doppar.com/versions/3.x/doppar-ia.html",
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/doppar/ia/issues",
    "source": "https://github.com/doppar/ia"
  },
  "authors": [
        {
            "name": "Pierre S"
        }
    ],
  "autoload": {
    "psr-4": {
      "Doppar\\AI\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1",
    "doppar/framework": "^3.0",
    "codewithkyrian/transformers": "^0.6.2",
    "symfony/ai-agent": "dev-main"
  },
  "extra": {
    "doppar": {
      "providers": [
        "Doppar\\AI\\TransformerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload-dev": {
    "psr-4": {
      "Doppar\\AI\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.4"
  },
  "scripts": {
    "phpstan": "phpstan analyse --level=8 --memory-limit=2G",
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "test": "phpunit",
    "analyse": [
      "@phpstan",
      "@cs-check"
    ]
  },
  "config": {
    "allow-plugins": {
      "codewithkyrian/platform-package-installer": true
    }
  }
}
